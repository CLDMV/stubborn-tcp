{
	"name": "@cldmv/stubborn-tcp",
	"version": "1.0.4",
	"description": "A stubbornly persistent TCP client that automatically reconnects when connections fail",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./types/index.d.mts",
	"exports": {
		".": {
			"stubborn-tcp-dev": {
				"types": "./types/index.d.mts",
				"import": "./src/index.mjs",
				"require": "./src/cjs-shim.cjs"
			},
			"types": "./types/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist/",
		"!dist/**/*.map",
		"types/"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsup",
		"build:ci": "npm run lint && npm run format:check && npm run types:build && npm run build",
		"prepack": "npm run build",
		"prepare": "node -e \"import('./.githooks/install.mjs').catch(()=>{})\"",
		"test": "node tests/run-vitest.mjs && npm run test:cjs",
		"test:cjs": "npm run build && node --test tests/cjs/entry.test.cjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet && npm run test:cjs",
		"ci:coverage": "npm run coverage",
		"types:build": "tsc -p .configs/tsconfig.json",
		"types:check": "tsc -p .configs/tsconfig.json --noEmit",
		"test:types": "npm run types:check",
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"lint:fix": "eslint --config .configs/eslint.config.mjs . --fix",
		"format": "prettier --config .configs/.prettierrc --write .",
		"format:check": "prettier --config .configs/.prettierrc --check .",
		"fix:headers": "fix-headers --config .configs/fix-headers.json"
	},
	"keywords": [
		"tcp",
		"client",
		"reconnect",
		"persistent",
		"stubborn",
		"socket",
		"network",
		"connection"
	],
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"license": "Apache-2.0",
	"engines": {
		"node": ">=14.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/stubborn-tcp.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/stubborn-tcp/issues"
	},
	"homepage": "https://github.com/CLDMV/stubborn-tcp#readme",
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@cldmv/configs": "^1.2.4",
		"@cldmv/eslint-plugin-jsonv": "^1.0.15",
		"@cldmv/fix-headers": "^2.2.0",
		"@cldmv/jsonv": "^1.1.3",
		"@cldmv/prettier-plugin-jsonv": "^1.1.3",
		"@cldmv/vitest-runner": "^1.5.2",
		"@eslint/css": "^2.0.0",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.0",
		"@eslint/markdown": "^8.0.3",
		"@types/node": "^26.6.4",
		"@vitest/coverage-v8": "^5.0.3",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"prettier": "^3.9.9",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
