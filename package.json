{
	"name": "@cldmv/stubborn-tcp",
	"version": "1.0.1",
	"description": "A stubbornly persistent TCP client that automatically reconnects when connections fail",
	"main": "./index.cjs",
	"module": "./index.mjs",
	"exports": {
		".": {
			"import": "./index.mjs",
			"require": "./index.cjs"
		}
	},
	"scripts": {
		"test": "node test/integration-test.mjs",
		"test:cjs": "node test/test-cjs-import.cjs",
		"test:all": "npm run test:cjs && npm run test",
		"build": "node scripts/build-cjs.mjs"
	},
	"keywords": [
		"tcp",
		"client",
		"reconnect",
		"persistent",
		"stubborn",
		"socket",
		"network",
		"connection"
	],
	"author": "CLDMV",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=14.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/CLDMV/stubborn-tcp.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/stubborn-tcp/issues"
	},
	"homepage": "https://github.com/CLDMV/stubborn-tcp#readme"
}
